# ── Supabase ───────────────────────────────────────────────
# Obtén estos valores en: https://supabase.com → Project Settings → API

# URL del proyecto (ej: https://abcxyz.supabase.co)
SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Service Role Key (PRIVADA — nunca subir a GitHub)
# Supabase Dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_KEY=eyJ...

# ── GitHub (opcional, para referencia) ─────────────────────
GITHUB_REPO=dankobuy-ops/Apps
GITHUB_BRANCH=main
