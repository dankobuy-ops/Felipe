---
interface Coverage {
  title: string;
  description: string;
  optional?: boolean;
}
interface Props {
  coverages: Coverage[];
}
const { coverages } = Astro.props;
---

<ul style="list-style:none; padding:0; margin:0; display:grid; grid-template-columns:repeat(2,1fr); gap:20px;">
  {coverages.map((c) => (
    <li style="background:#fff; border:1px solid #e2e4e8; border-radius:6px; padding:24px; display:flex; gap:16px; align-items:flex-start;">
      <div style="flex-shrink:0; width:32px; height:32px; background:#4D3B62; border-radius:4px; display:flex; align-items:center; justify-content:center; margin-top:2px;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#C7A965" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 6 9 17l-5-5"/>
        </svg>
      </div>
      <div>
        <p style="font-family:'Cinzel',serif; font-size:15px; font-weight:600; color:#4D3B62; margin-bottom:6px;">
          {c.title}
          {c.optional && (
            <span style="font-size:10px; background:#f2f4f6; color:#8D99AE; border-radius:3px; padding:2px 6px; margin-left:8px; vertical-align:middle; text-transform:uppercase; letter-spacing:0.05em;">
              Opcional
            </span>
          )}
        </p>
        <p style="font-size:14px; color:#55556d; line-height:1.6;">{c.description}</p>
      </div>
    </li>
  ))}
</ul>

<style>
  @media (max-width: 767px) {
    ul { grid-template-columns: 1fr !important; }
  }
</style>
