---
import Layout from "@/layouts/Layout.astro";
import { partners } from "@/data/partners";
const base = import.meta.env.BASE_URL;
---

<Layout
  title="Seguros Aegis"
  description="Tu aliado estratégico en seguros. Asesoría experta, acceso a múltiples compañías y sin costo para ti."
>

  <!-- ═══ HERO ═══ -->
  <section style="position:relative; min-height:580px; display:flex; align-items:center; justify-content:center; overflow:hidden; background:#0e0a15; text-align:center;">
    <div style={`position:absolute; inset:0; background-image:url('${base}/images/skyline3.webp'); background-size:cover; background-position:center; opacity:0.40;`}></div>
    <div style="position:absolute; inset:0; background:linear-gradient(to bottom, rgba(14,10,21,0.55) 0%, rgba(14,10,21,0.78) 100%);"></div>

    <div class="container-page" style="position:relative; z-index:1; padding-block:110px;">
      <h1 style="font-family:'Cinzel',serif; font-size:clamp(38px,6vw,66px); font-weight:600; color:#fff; line-height:1.1; margin-bottom:18px; letter-spacing:0.01em;">
        Tu Aliado Estratégico
      </h1>
      <p style="font-family:'Cinzel',serif; font-size:clamp(13px,1.4vw,16px); color:rgba(255,255,255,0.82); margin-bottom:44px; max-width:520px; margin-inline:auto; line-height:1.6;">
        Asesoría experta, acceso a múltiples compañías y sin costo para ti.
      </p>
      <div style="display:inline-flex; align-items:center; gap:10px; border:1px solid rgba(255,255,255,0.25); border-radius:4px; padding:8px 20px; background:rgba(255,255,255,0.05);">
        <span style="font-family:'Cinzel',serif; font-size:11px; font-weight:600; color:rgba(255,255,255,0.85); text-transform:uppercase; letter-spacing:0.1em;">Miembro ANS</span>
        <img src={`${base}/images/ans-logo.png`} alt="ANS" style="height:28px; width:auto;" />
      </div>
    </div>
  </section>

  <!-- ═══ VALUE PROPS ═══ -->
  <section style="position:relative; overflow:hidden; background:#1a1025;">
    <div style={`position:absolute; inset:0; background-image:url('${base}/images/fondo-inicio.webp'); background-size:cover; background-position:center 20%;`}></div>
    <div style="position:absolute; inset:0; background:linear-gradient(to right, rgba(14,10,21,0.72) 0%, rgba(14,10,21,0.72) 50%, rgba(14,10,21,0.15) 100%);"></div>

    <div style="position:relative; z-index:1; display:grid; grid-template-columns:1fr 1fr; max-width:760px; min-height:600px;">
      {[
        { title: "Cotiza con Múltiples Compañías", desc: "Accede a una visión completa del mercado en minutos, sin sesgos ni restricciones." },
        { title: "Centraliza tus Seguros", desc: "Administra tus seguros en un solo lugar. Automotriz, Hogar, Salud y más." },
        { title: "Sin Costo para Ti", desc: "Nosotros no te cobramos un solo peso." },
        { title: "Acompañamiento Experto", desc: "Estamos contigo en todo momento. Contratación, Siniestros y Renovaciones." },
      ].map((item, i) => (
        <div style={`padding:60px 40px; display:flex; flex-direction:column; justify-content:center; border-bottom:${i < 2 ? "1px solid rgba(255,255,255,0.1)" : "none"}; border-right:${i % 2 === 0 ? "1px solid rgba(255,255,255,0.1)" : "none"};`}>
          <h3 style="font-family:'Cinzel',serif; font-size:17px; font-weight:700; color:#C7A965; text-transform:uppercase; letter-spacing:0.1em; margin-bottom:14px; line-height:1.4;">
            {item.title}
          </h3>
          <p style="font-size:14px; color:rgba(255,255,255,0.65); line-height:1.75; font-family:'Cinzel',serif;">
            {item.desc}
          </p>
        </div>
      ))}
    </div>
  </section>

  <!-- ═══ ¿POR QUÉ ELEGIR? ═══ -->
  <section style="background:#1a1025; padding-block:60px; text-align:center; border-top:1px solid rgba(255,255,255,0.06);">
    <div class="container-page">
      <h2 style="font-family:'Cinzel',serif; font-size:clamp(23px,3.6vw,39px); font-weight:600; color:#C7A965; margin-bottom:16px;">
        ¿Por qué elegir Seguros Aegis?
      </h2>
      <p style="font-family:'Cinzel',serif; font-size:17px; color:rgba(255,255,255,0.65); max-width:560px; margin-inline:auto; line-height:1.8;">
        Conocemos el mercado, entendemos tus necesidades, y trabajamos contigo para encontrar las mejores condiciones disponibles. Profesionalismo, eficiencia y cero costos ocultos.
      </p>
    </div>
  </section>

  <!-- ═══ PRODUCTOS ═══ -->
  <section style="display:grid; grid-template-columns:1fr 1fr;" class="products-section">
    <div style="position:relative; overflow:hidden; min-height:320px;">
      <div style={`position:absolute; inset:0; background-image:url('${base}/images/autos.webp'); background-size:cover; background-position:center;`}></div>
      <div style="position:absolute; inset:0; background:linear-gradient(to top, rgba(0,0,0,0.7) 0%, rgba(0,0,0,0.15) 65%);"></div>
      <div style="position:absolute; bottom:0; left:0; right:0; padding:36px 40px; text-align:center;">
        <h3 style="font-family:'Cinzel',serif; font-size:clamp(20px,2.5vw,28px); font-weight:600; color:#fff; letter-spacing:0.04em; text-transform:uppercase;">Seguro Vehicular</h3>
      </div>
    </div>
    <div style="position:relative; overflow:hidden; min-height:320px;">
      <div style={`position:absolute; inset:0; background-image:url('${base}/images/familia.webp'); background-size:cover; background-position:center;`}></div>
      <div style="position:absolute; inset:0; background:linear-gradient(to top, rgba(0,0,0,0.65) 0%, rgba(0,0,0,0.1) 65%);"></div>
      <div style="position:absolute; bottom:0; left:0; right:0; padding:36px 40px; text-align:center;">
        <h3 style="font-family:'Cinzel',serif; font-size:clamp(20px,2.5vw,28px); font-weight:600; color:#fff; letter-spacing:0.04em; text-transform:uppercase;">Seguro Hogar</h3>
      </div>
    </div>
  </section>

  <!-- ═══ COMPAÑÍAS ═══ -->
  <section style="background:#fff; padding-block:48px; border-top:1px solid #e2e4e8;">
    <p style="text-align:center; font-family:'Cinzel',serif; font-size:19.5px; font-weight:600; color:#4D3B62; text-transform:uppercase; letter-spacing:0.1em; margin-bottom:32px;">
      Compañías con las que trabajamos
    </p>
    <ul style="list-style:none; padding:0 24px; margin:0; display:flex; flex-wrap:nowrap; align-items:center; justify-content:center; gap:32px; width:100%; box-sizing:border-box;">
      {partners.map((p) => (
        <li style="display:flex; align-items:center; justify-content:center; width:100px; flex-shrink:0;">
          <a href={p.url} target="_blank" rel="noopener noreferrer" title={p.name} style="display:flex; align-items:center; justify-content:center; width:100%;">
            <img src={`${base}/images/partners/${p.slug}.${p.ext}`} alt={p.name} style="max-height:49px; max-width:100px; width:auto; display:block; object-fit:contain;" loading="lazy" />
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- ═══ CMF / ANS ═══ -->
  <section style="background:#4D3B62; padding-block:32px;">
    <div class="container-page" style="display:flex; flex-direction:column; align-items:center; gap:16px;">
      <div style="display:flex; align-items:center; gap:12px;">
        <span style="font-family:'Cinzel',serif; font-size:12px; font-weight:600; color:#C7A965; text-transform:uppercase; letter-spacing:0.1em;">Supervisados por</span>
        <span style="font-family:'Cinzel',serif; font-size:14px; font-weight:700; color:#fff; background:rgba(255,255,255,0.12); padding:4px 14px; border-radius:4px; letter-spacing:0.08em;">CMF</span>
      </div>
      <div style="display:flex; align-items:center; gap:12px;">
        <span style="font-family:'Cinzel',serif; font-size:12px; font-weight:600; color:#C7A965; text-transform:uppercase; letter-spacing:0.1em;">Miembro ANS</span>
        <img src={`${base}/images/ans-logo.png`} alt="ANS" style="height:32px; width:auto;" />
      </div>
    </div>
  </section>

</Layout>

<style>
  @media (max-width: 767px) {
    .products-section { grid-template-columns: 1fr !important; }
  }
</style>
