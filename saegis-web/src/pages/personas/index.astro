---
import Layout from "@/layouts/Layout.astro";
import PartnersStrip from "@/components/PartnersStrip.astro";
import CTA from "@/components/CTA.astro";
import { personaProducts } from "@/data/products";

// Mapa de íconos SVG por producto
const iconMap: Record<string, string> = {
  Car: `<path d="M19 17H5a2 2 0 0 1-2-2v-4"/><path d="M5 9a4 4 0 0 1 4-4h6a4 4 0 0 1 4 4v4"/><circle cx="7" cy="17" r="2"/><circle cx="17" cy="17" r="2"/>`,
  Home: `<path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>`,
  Stethoscope: `<path d="M4.8 2.3A.3.3 0 1 0 5 2H4a2 2 0 0 0-2 2v5a6 6 0 0 0 6 6 6 6 0 0 0 6-6V4a2 2 0 0 0-2-2h-1a.2.2 0 1 0 .3.3"/><path d="M8 15v1a6 6 0 0 0 6 6 6 6 0 0 0 6-6v-4"/><circle cx="20" cy="10" r="2"/>`,
  HeartPulse: `<path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/><path d="M3.22 12H9.5l.5-1 2 4.5 2-7 1.5 3.5h5.27"/>`,
  Plane: `<path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"/>`,
  Bike: `<circle cx="18.5" cy="17.5" r="3.5"/><circle cx="5.5" cy="17.5" r="3.5"/><circle cx="15" cy="5" r="1"/><path d="M12 17.5V14l-3-3 4-3 2 3h2"/>`,
  Trophy: `<path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2z"/>`,
  PersonStanding: `<circle cx="12" cy="5" r="1"/><path d="m9 20 3-6 3 6"/><path d="m6 8 6 2 6-2"/><path d="M12 10v4"/>`,
  Globe: `<circle cx="12" cy="12" r="10"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/><path d="M2 12h20"/>`,
  Shield: `<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/>`,
  Briefcase: `<path d="M16 20V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/><rect width="20" height="14" x="2" y="6" rx="2"/>`,
};
---

<Layout
  title="Seguros para Personas"
  description="Vehicular, hogar, salud, viajes, bicicleta, deportivo y responsabilidad civil. Asesoría independiente para ti y tu familia."
>

  <!-- HERO -->
  <section style="background:#4D3B62; padding-block:100px; position:relative; overflow:hidden;">
    <div style="position:absolute; inset:0; background:rgba(0,0,0,0.3);"></div>
    <div class="container-page" style="position:relative; z-index:1;">
      <p style="font-family:'Cinzel',serif; font-size:12px; font-weight:600; text-transform:uppercase; letter-spacing:0.12em; color:#C7A965; margin-bottom:16px;">Personas</p>
      <h1 style="font-family:'Cinzel',serif; font-size:clamp(28px,5vw,52px); font-weight:600; color:#fff; margin-bottom:20px; max-width:600px;">
        Protección para ti y tu familia
      </h1>
      <p style="font-size:17px; color:rgba(255,255,255,0.8); max-width:540px; line-height:1.7;">
        Coberturas flexibles que acompañan cada etapa de tu vida. Explora nuestro portafolio y conversemos sobre el plan que mejor se adapta a ti.
      </p>
    </div>
  </section>

  <!-- CATÁLOGO -->
  <section style="background:#f2f4f6; padding-block:100px;">
    <div class="container-page">
      <ul style="list-style:none; padding:0; margin:0; display:grid; grid-template-columns:repeat(3,1fr); gap:24px;">
        {personaProducts.map((p) => (
          <li>
            <div
              style="background:#fff; border:1px solid #e2e4e8; border-radius:6px; padding:32px 24px; height:100%; display:flex; flex-direction:column; position:relative; transition:all 0.2s;"
              onmouseover="this.style.borderColor='#C7A965'; this.style.transform='translateY(-2px)'; this.style.boxShadow='0 8px 24px rgba(77,59,98,0.12)';"
              onmouseout="this.style.borderColor='#e2e4e8'; this.style.transform=''; this.style.boxShadow='';"
            >
              {p.tag && (
                <span style="position:absolute; top:16px; right:16px; background:#C7A965; color:#261c30; font-family:'Cinzel',serif; font-size:10px; font-weight:600; padding:3px 10px; border-radius:20px; text-transform:uppercase; letter-spacing:0.06em;">
                  {p.tag}
                </span>
              )}
              <div style="width:52px; height:52px; background:#4D3B62; border-radius:6px; display:flex; align-items:center; justify-content:center; margin-bottom:20px; flex-shrink:0;">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#C7A965" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={iconMap[p.icon] ?? iconMap.Shield} />
              </div>
              <h3 style="font-family:'Cinzel',serif; font-size:17px; font-weight:600; color:#4D3B62; margin-bottom:10px;">{p.title}</h3>
              <p style="font-size:14px; color:#55556d; line-height:1.7; flex:1;">{p.shortDescription}</p>
              <a
                href="/contacto"
                style="display:inline-block; margin-top:20px; font-family:'Cinzel',serif; font-size:12px; font-weight:600; color:#C7A965; text-decoration:none; text-transform:uppercase; letter-spacing:0.05em;"
              >
                Cotizar →
              </a>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <PartnersStrip />
  <CTA />
</Layout>

<style>
  @media (max-width: 1024px) {
    section:nth-of-type(2) ul { grid-template-columns: repeat(2,1fr) !important; }
  }
  @media (max-width: 767px) {
    section:nth-of-type(2) ul { grid-template-columns: 1fr !important; }
  }
</style>
