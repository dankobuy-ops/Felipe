---
import Layout from "@/layouts/Layout.astro";
import PartnersStrip from "@/components/PartnersStrip.astro";
import { company } from "@/data/company";
---

<Layout
  title="Contacto"
  description="Cotiza tu seguro con Seguros Aegis. Teléfono, email y formulario de contacto directo."
>

  <section style="background:#4D3B62; padding-block:100px; position:relative; overflow:hidden;">
    <div style="position:absolute; inset:0; background:rgba(0,0,0,0.3);"></div>
    <div class="container-page" style="position:relative; z-index:1;">
      <p style="font-family:'Cinzel',serif; font-size:12px; font-weight:600; text-transform:uppercase; letter-spacing:0.12em; color:#C7A965; margin-bottom:16px;">Contacto</p>
      <h1 style="font-family:'Cinzel',serif; font-size:clamp(28px,5vw,52px); font-weight:600; color:#fff; margin-bottom:20px; max-width:600px;">
        Conversemos sobre tu protección
      </h1>
      <p style="font-size:17px; color:rgba(255,255,255,0.8); max-width:540px; line-height:1.7;">
        Cuéntanos qué necesitas y te respondemos el mismo día hábil.
      </p>
    </div>
  </section>

  <section style="background:#f2f4f6; padding-block:100px;">
    <div class="container-page" style="display:grid; grid-template-columns:1fr 1.6fr; gap:64px; align-items:start;">

      <!-- Info de contacto -->
      <div>
        <p style="font-family:'Cinzel',serif; font-size:12px; font-weight:600; text-transform:uppercase; letter-spacing:0.12em; color:#8D99AE; margin-bottom:12px;">
          Canales de contacto
        </p>
        <h2 style="font-family:'Cinzel',serif; font-size:24px; font-weight:600; color:#4D3B62; margin-bottom:32px;">
          Estamos a un clic de distancia.
        </h2>

        <ul style="list-style:none; padding:0; margin:0; display:flex; flex-direction:column; gap:12px;">
          {[
            { icon: `<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.62 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>`, label: "Teléfono", value: company.phone, href: company.phoneHref },
            { icon: `<path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/>`, label: "WhatsApp", value: "Escríbenos", href: company.whatsappHref, external: true },
            { icon: `<rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>`, label: "Email", value: company.email, href: company.emailHref },
            { icon: `<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>`, label: "Oficina", value: `${company.address.street}, ${company.address.city}`, href: null },
            { icon: `<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>`, label: "Horario", value: company.schedule, href: null },
          ].map(({ icon, label, value, href, external }) => (
            <li>
              {href ? (
                <a
                  href={href}
                  target={external ? "_blank" : undefined}
                  rel={external ? "noopener noreferrer" : undefined}
                  style="display:flex; gap:16px; align-items:flex-start; background:#fff; border:1px solid #e2e4e8; border-radius:6px; padding:16px; text-decoration:none; transition:border-color 0.2s;"
                  onmouseover="this.style.borderColor='#C7A965';"
                  onmouseout="this.style.borderColor='#e2e4e8';"
                >
                  <div style="width:40px; height:40px; background:#4D3B62; border-radius:6px; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#C7A965" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={icon} />
                  </div>
                  <div>
                    <p style="font-family:'Cinzel',serif; font-size:11px; font-weight:600; text-transform:uppercase; letter-spacing:0.08em; color:#8D99AE; margin-bottom:4px;">{label}</p>
                    <p style="font-family:'Cinzel',serif; font-size:14px; font-weight:600; color:#4D3B62;">{value}</p>
                  </div>
                </a>
              ) : (
                <div style="display:flex; gap:16px; align-items:flex-start; background:#fff; border:1px solid #e2e4e8; border-radius:6px; padding:16px;">
                  <div style="width:40px; height:40px; background:#4D3B62; border-radius:6px; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#C7A965" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={icon} />
                  </div>
                  <div>
                    <p style="font-family:'Cinzel',serif; font-size:11px; font-weight:600; text-transform:uppercase; letter-spacing:0.08em; color:#8D99AE; margin-bottom:4px;">{label}</p>
                    <p style="font-family:'Cinzel',serif; font-size:14px; font-weight:600; color:#4D3B62;">{value}</p>
                  </div>
                </div>
              )}
            </li>
          ))}
        </ul>

        <p style="font-size:12px; color:#8D99AE; margin-top:24px; line-height:1.6;">
          {company.name} está inscrita en el Registro de Corredores de Seguros de la Comisión para el Mercado Financiero (CMF).
        </p>
      </div>

      <!-- Formulario Google -->
      <div>
        <p style="font-family:'Cinzel',serif; font-size:12px; font-weight:600; text-transform:uppercase; letter-spacing:0.12em; color:#8D99AE; margin-bottom:12px;">
          Formulario
        </p>
        <h2 style="font-family:'Cinzel',serif; font-size:24px; font-weight:600; color:#4D3B62; margin-bottom:24px;">
          Cuéntanos qué seguro necesitas.
        </h2>
        <div id="formulario" style="overflow:hidden; border-radius:6px; border:1px solid #e2e4e8; background:#fff; box-shadow:0 2px 8px rgba(77,59,98,0.08);">
          <iframe
            src={company.googleFormUrl}
            title="Formulario de contacto"
            width="100%"
            height="900"
            frameborder="0"
            loading="lazy"
            style="display:block; width:100%;"
          >
            Cargando formulario…
          </iframe>
          <div style="display:flex; justify-content:flex-end; padding:12px 16px; border-top:1px solid #e2e4e8; background:#f2f4f6;">
            <a
              href={company.googleFormUrlShare}
              target="_blank"
              rel="noopener noreferrer"
              style="font-family:'Cinzel',serif; font-size:12px; font-weight:600; color:#4D3B62; text-decoration:none; text-transform:uppercase; letter-spacing:0.05em;"
            >
              Abrir en nueva pestaña →
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <PartnersStrip title="Comparamos propuestas entre 10 aseguradoras líderes" />
</Layout>

<style>
  @media (max-width: 1024px) {
    section:nth-of-type(2) .container-page {
      grid-template-columns: 1fr !important;
    }
  }
</style>
