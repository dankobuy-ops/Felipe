---
const base = import.meta.env.BASE_URL;

interface Props {
  label?: string;
  title: string;
  subtitle?: string;
  image?: string;           // nombre de archivo en /images/ (ej: "hero-nosotros.png")
  bgColor?: string;         // color de fondo si no hay imagen (default: #4D3B62)
  overlayOpacity?: number;  // opacidad del overlay oscuro (default: 0.15)
  minHeight?: number;       // altura mínima en px (default: 500)
  align?: "left" | "center";
}

const {
  label,
  title,
  subtitle,
  image,
  bgColor = "#4D3B62",
  overlayOpacity = 0.15,
  minHeight = 500,
  align = "left",
} = Astro.props;

const textAlign = align === "center" ? "center" : "left";
const maxWidth = align === "center" ? "800px" : "620px";
const margin = align === "center" ? "0 auto" : "0";

const bgStyle = image
  ? `background-image:url('${base}/images/${image}'); background-size:cover; background-position:center;`
  : `background:${bgColor};`;
---

<section style={`position:relative; overflow:hidden; min-height:${minHeight}px; display:flex; align-items:center; ${bgStyle}`}>
  <div style={`position:absolute; inset:0; background:rgba(0,0,0,${overlayOpacity});`}></div>
  <div class="container-page" style="position:relative; z-index:1; padding-block:100px; width:100%;">
    <div style={`max-width:${maxWidth}; margin:${margin}; text-align:${textAlign};`}>
      {label && (
        <p style="font-family:'Cinzel',serif; font-size:12px; font-weight:600; text-transform:uppercase; letter-spacing:0.12em; color:#C7A965; margin-bottom:16px;">
          {label}
        </p>
      )}
      <h1 style="font-family:'Cinzel',serif; font-size:clamp(28px,5vw,52px); font-weight:600; color:#fff; margin-bottom:20px; line-height:1.15;">
        {title}
      </h1>
      {subtitle && (
        <p style="font-size:17px; color:rgba(255,255,255,0.85); max-width:540px; line-height:1.7;" style={align === "center" ? "margin:0 auto;" : ""}>
          {subtitle}
        </p>
      )}
      <slot />
    </div>
  </div>
</section>
