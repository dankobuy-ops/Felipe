---
import { testimonials } from "@/data/testimonials";
---

<section class="section-y bg-(--color-surface)">
  <div class="container-page">
    <div class="mx-auto max-w-2xl text-center">
      <p class="mb-3 text-sm font-medium uppercase tracking-wider text-(--color-muted-foreground)">
        Clientes
      </p>
      <h2 class="font-display text-3xl text-(--color-foreground) sm:text-4xl">
        Confianza que se construye con el tiempo.
      </h2>
    </div>

    <ul class="mt-14 grid gap-6 md:grid-cols-3">
      {testimonials.map((t) => (
        <li class="relative flex flex-col rounded-2xl border border-(--color-border) bg-(--color-background) p-7 shadow-[var(--shadow-card)]">
          <svg class="size-8 text-(--color-accent)" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V20c0 1 0 1 1 1z"/>
            <path d="M15 21c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2h.75c0 2.25.25 4-2.75 4v3c0 1 0 1 1 1z"/>
          </svg>
          <p class="mt-5 flex-1 text-[0.95rem] leading-relaxed text-(--color-foreground)/85">
            "{t.quote}"
          </p>
          <div class="mt-6 border-t border-(--color-border) pt-5">
            <p class="font-medium text-(--color-foreground)">{t.name}</p>
            <p class="text-xs text-(--color-muted-foreground)">{t.role}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
