---
const base = import.meta.env.BASE_URL;
interface Props {
  title?: string;
  subtitle?: string;
}
const {
  title = "Solicita tu cotización ahora",
  subtitle = "No esperes más, solicita tu cotización ahora y relájate al saber que estarás bien protegido",
} = Astro.props;
---

<section
  style={`position:relative; overflow:hidden; min-height:500px; display:flex; align-items:center; background-image:url('${base}/images/cotiza-ahora.png'); background-size:cover; background-position:center center;`}
>
  <div style="position:absolute; inset:0; background-color:rgba(141,153,174,0.18);"></div>
  <div class="container-page" style="position:relative; z-index:1; text-align:center; padding-block:80px;">
    <h3 style="font-family:'Cinzel',serif; font-size:clamp(24px,4vw,38px); font-weight:600; color:#261c30; margin-bottom:16px;">
      {title}
    </h3>
    <p style="font-family:'Cinzel',serif; font-size:16px; color:#261c30; margin-bottom:36px; max-width:560px; margin-inline:auto;">
      {subtitle}
    </p>
    <a
      href={`${base}contacto`}
      style="display:inline-block; padding:14px 40px; background:#C7A965; color:#261c30; font-family:'Cinzel',serif; font-size:14px; font-weight:600; text-decoration:none; border-radius:4px; text-transform:uppercase; letter-spacing:0.08em; transition:background 0.2s;"
      onmouseover="this.style.background='#b89550';"
      onmouseout="this.style.background='#C7A965';"
    >
      Solicitar Cotización →
    </a>
  </div>
</section>

<style>
  @media (max-width: 767px) {
    section { min-height: 300px !important; }
  }
</style>
