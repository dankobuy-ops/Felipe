---
import { footerNav } from "@/data/navigation";
const year = new Date().getFullYear();
---

<footer style="background:#0d0d0d;">
  <!-- Nav links -->
  <div style="border-bottom:1px solid rgba(255,255,255,0.08); padding-block:24px;">
    <nav class="container-page" style="display:flex; align-items:center; justify-content:center; flex-wrap:wrap; gap:4px;">
      {footerNav.map((item) => (
        <a
          href={item.href}
          style="padding:6px 16px; font-family:'Cinzel',serif; font-size:13px; font-weight:500; color:rgba(255,255,255,0.7); text-decoration:none; letter-spacing:0.05em; transition:color 0.15s;"
          onmouseover="this.style.color='#C7A965';"
          onmouseout="this.style.color='rgba(255,255,255,0.7)';"
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>
  <!-- Copyright -->
  <div class="container-page" style="padding-block:20px; text-align:center;">
    <p style="font-family:'Cinzel',serif; font-size:12px; color:rgba(255,255,255,0.4); margin-bottom:4px;">
      © {year} Seguros Aegis. Todos los derechos reservados
    </p>
    <a href="mailto:contacto@segurosaegis.cl" style="font-family:'Cinzel',serif; font-size:12px; color:rgba(255,255,255,0.4); text-decoration:none; text-transform:lowercase; letter-spacing:0.02em;">
      contacto@segurosaegis.cl
    </a>
  </div>
</footer>
