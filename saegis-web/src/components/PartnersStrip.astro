---
import { partners } from "@/data/partners";
const base = import.meta.env.BASE_URL;

interface Props {
  title?: string;
}
const { title = "Trabajamos con las principales aseguradoras del país" } = Astro.props;
---

<section style="background:#f2f4f6; border-top:1px solid #e2e4e8; border-bottom:1px solid #e2e4e8; padding-block:60px;">
  <div class="container-page">
    <p style="text-align:center; font-family:'Cinzel',serif; font-size:13px; font-weight:600; text-transform:uppercase; letter-spacing:0.1em; color:#8D99AE; margin-bottom:8px;">
      Aseguradoras asociadas
    </p>
    <h2 style="text-align:center; font-family:'Cinzel',serif; font-size:20px; font-weight:600; color:#4D3B62; margin-bottom:40px;">
      {title}
    </h2>
    <ul style="list-style:none; padding:0; margin:0; display:grid; grid-template-columns:repeat(5,1fr); gap:32px 24px; align-items:center;">
      {partners.map((p) => (
        <li style="display:flex; align-items:center; justify-content:center;">
          <img
            src={`${base}images/partners/${p.slug}.${p.ext}`}
            alt={p.name}
            style="max-height:40px; width:auto; opacity:0.65; transition:opacity 0.2s; filter:grayscale(30%);"
            loading="lazy"
            onmouseover="this.style.opacity='1'; this.style.filter='grayscale(0)';"
            onmouseout="this.style.opacity='0.65'; this.style.filter='grayscale(30%)';"
          />
        </li>
      ))}
    </ul>

    <!-- Badges reguladores -->
    <div style="display:flex; justify-content:center; align-items:center; gap:24px; margin-top:40px; padding-top:32px; border-top:1px solid #e2e4e8; flex-wrap:wrap;">
      <div style="display:flex; align-items:center; gap:8px; background:#fff; border:1px solid #e2e4e8; border-radius:6px; padding:10px 20px;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#4D3B62" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          <polyline points="9 12 11 14 15 10"/>
        </svg>
        <span style="font-family:'Cinzel',serif; font-size:12px; font-weight:600; color:#4D3B62; text-transform:uppercase; letter-spacing:0.05em;">Miembro ANS</span>
      </div>
      <div style="display:flex; align-items:center; gap:8px; background:#fff; border:1px solid #e2e4e8; border-radius:6px; padding:10px 20px;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#4D3B62" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          <polyline points="9 12 11 14 15 10"/>
        </svg>
        <span style="font-family:'Cinzel',serif; font-size:12px; font-weight:600; color:#4D3B62; text-transform:uppercase; letter-spacing:0.05em;">Regulado CMF</span>
      </div>
    </div>
  </div>
</section>

<style>
  @media (max-width: 767px) {
    section ul { grid-template-columns: repeat(3, 1fr) !important; }
  }
</style>
