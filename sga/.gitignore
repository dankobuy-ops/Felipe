# ── Entorno virtual ───────────────────────────────────────
venv/
.venv/
env/
ENV/

# ── Variables de entorno (NUNCA subir) ────────────────────
.env
.env.*
!.env.example

# ── Python cache ──────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# ── Distribución / build ──────────────────────────────────
dist/
build/
*.egg-info/
*.egg

# ── Tests ─────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ── IDEs ──────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Alembic ───────────────────────────────────────────────
