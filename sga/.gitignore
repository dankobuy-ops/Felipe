# ── Logs ──────────────────────────────────────────────────
*.log
logs/

# ── OS ────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Node (frontend) ───────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.local
.gstack/
