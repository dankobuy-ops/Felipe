# Copy to scraper/.env and fill in. The watcher loads this automatically.
# .env is gitignored — never commit your real service key.
SUPABASE_URL=https://xjlpsgchgfxryvhhrklx.supabase.co
SUPABASE_SERVICE_KEY=your-service_role-key-here

# Only needed if you run export_sheets.py locally (the app's export button uses
# the export.yml GitHub Action instead, which has these set inline):
SHEETS_WEBHOOK_URL=your-apps-script-/exec-url
SHEETS_ID=your-spreadsheet-id
