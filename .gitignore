# Ignorar por defecto archivos de código y entornos de desarrollo
*.py
*.js
*.jsx
*.ts
*.tsx
*.html
*.css
*.json
*.sql
node_modules/
venv/
.venv/
dist/
build/

# REGLAS DE EXCEPCIÓN: Forzar el rastreo de contexto y memorias
!**/CLAUDE.md
!**/.claude/
!**/.claude/**
!*.docx
!*.pdf
!*.md
!*.csv

# EXCEPCIÓN: felipe/ es un proyecto de código — rastrear todo
!felipe/**
!felipe/.github/**

# ...pero NUNCA los entornos virtuales ni caches: son locales de cada PC
# (rutas absolutas del usuario/Python) y no se pueden compartir entre máquinas.
felipe/**/.venv/
felipe/**/venv/
felipe/**/__pycache__/
felipe/**/*.pyc

# EXCEPCIÓN: webcam/ es un proyecto de código — rastrear todo
# (los datos de captura, el venv y la BD los excluye webcam/.gitignore)
!webcam/**

# EXCEPCIÓN: cias/ es un proyecto de código — rastrear todo
# (usa el venv compartido de felipe/; sólo se excluyen caches locales)
!cias/**
cias/**/__pycache__/
cias/**/*.pyc

.gstack/

# Notas locales de sesión (IDs de --resume, scratch): son de cada PC
session.txt
